{
  "name": "@uniswap/v3-periphery",
  "description": "🎚 SurpSwap V3 peripheral smart contracts",
  "license": "GPL-2.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.4.4",
  "homepage": "https://uniswap.org",
  "keywords": [
    "surpswap",
    "periphery",
    "v3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Uniswap/uniswap-v3-periphery"
  },
  "files": [
