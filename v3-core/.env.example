# Never commit your real private key. Use a dedicated deployer wallet.
PRIVATE_KEY=

# Polygon PoS mainnet (chain ID 137). Use an RPC endpoint you trust.
POLYGON_RPC_URL=https://polygon-rpc.com

# Polygon Amoy testnet (chain ID 80002). Can be overridden with your own RPC.
AMOY_RPC=https://rpc-amoy.polygon.technology

# PolygonScan API key for contract verification.
ETHERSCAN_API_KEY=

# Change to YES only when you intentionally want to deploy on Polygon mainnet.
CONFIRM_POLYGON_MAINNET_DEPLOY=
